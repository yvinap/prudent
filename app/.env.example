# Copy this file to .env.local and fill in the values from your CDK stack outputs.
# Run `cdk deploy` to get these values as CloudFormation outputs.

# Cognito User Pool ID (e.g. us-east-1_xxxxxxxxx)
VITE_USER_POOL_ID=

# Cognito App Client ID
VITE_USER_POOL_CLIENT_ID=

# Cognito Hosted UI domain (WITHOUT https://, e.g. prudent-123456789012.auth.us-east-1.amazoncognito.com)
VITE_COGNITO_DOMAIN=

# API Gateway base URL (WITH https://, e.g. https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod)
VITE_API_URL=

# Redirect URI — must match a callback URL registered in the Cognito App Client
# For local development: http://localhost:5173
VITE_REDIRECT_URI=http://localhost:5173
